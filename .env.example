# ==============================================================================
# Riot ReImagined - Monorepo Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/riot_reimagined
# Containerized MongoDB (used in Docker Compose):
# MONGO_URI=mongodb://mongo:27017/riot_reimagined

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ------------------------------------------------------------------------------
# 4. External Gaming APIs
# ------------------------------------------------------------------------------
# Riot Games Developer Portal: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# HenrikDev Valorant API: https://docs.henrikdev.xyz/
HENRIK_DEV_API_KEY=HDEV-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. Redis Caching (Optional - Upstash or Local Redis)
# ------------------------------------------------------------------------------
# Local / Containerized Redis:
REDIS_URL=redis://localhost:6379

# Or Upstash Serverless Redis REST API:
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ------------------------------------------------------------------------------
# 6. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000
