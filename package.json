{
  "name": "riot-web-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run dev:all",
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "data:import": "npm run data:import --workspace=backend",
    "data:destroy": "npm run data:destroy --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
