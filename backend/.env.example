# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://riot-web-ten.vercel.app

# Database
MONGO_URI=mongodb://localhost:27017/riot_reimagined

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# External APIs
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HENRIK_DEV_API_KEY=HDEV-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Upstash Redis Caching (Optional)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
